# ─── MCP Transport ────────────────────────────────────────────────────────────
# "stdio"           — local subprocess (Claude Desktop / Claude Code / Zed)
# "streamable-http" — remote HTTP server (containers, cloud deploys)
#
# On a cloud host (IBM Code Engine, Databricks Apps) you usually leave this as
# stdio: app.py automatically switches to HTTP when the platform injects a port
# (DATABRICKS_APP_PORT or PORT).
MCP_TRANSPORT=stdio

# ─── HTTP Server (only used when running over HTTP) ───────────────────────────
MCP_HOST=0.0.0.0
MCP_PORT=8000

# ─── Knowledge Graph ──────────────────────────────────────────────────────────
# Path to the Turtle file loaded into pyoxigraph at server startup.
KG_DATA_PATH=data/texas_flood2.ttl
# Path to the YAML schema / query-guidance file served as the kg://schema resource.
KG_SCHEMA_PATH=data/schema_prototype2.yml
# Path to the YAML analyst guidelines file served as kg://query-guidelines
# and returned by the flood_kg_analyst prompt.
KG_GUIDELINES_PATH=data/prompt_guidelines2.yml

# ─── USAi Gateway (eval/phoenix/ harness) ────────────────────────────────────
# Base URL for the USAi OpenAI-compatible gateway. Do NOT include /api/v1 here;
# the harness appends it automatically.
USAI_BASE_URL=https://<your-usai-host>

# API key for the USAi gateway.
USAI_API_KEY=

# Model id for the agent under test. Must match an exact USAi model identifier.
# To list available ids, see step 3 in eval/phoenix/README.md.
AGENT_MODEL=

# Model id for the LLM judges. Use a strong model, separate from AGENT_MODEL,
# to avoid self-preference bias.
JUDGE_MODEL=
