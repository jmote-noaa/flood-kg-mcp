<http://example.org/flood-ontology#removes> rdfs:domain <http://example.org/flood-ontology#Intervention>;
  rdfs:range <http://example.org/flood-ontology#Entity>;
  owl:inverseOf <http://example.org/flood-ontology#is_removed_by> .

<http://example.org/flood-ontology#is_represented_by> rdfs:domain <http://example.org/flood-ontology#Abstract_System_Concept>;
  rdfs:range <http://example.org/flood-ontology#Information_Artifact>;
  owl:inverseOf <http://example.org/flood-ontology#represents> .

<http://example.org/flood-ontology#represents> rdfs:domain <http://example.org/flood-ontology#Information_Artifact>;
  rdfs:range <http://example.org/flood-ontology#Abstract_System_Concept>;
  owl:inverseOf <http://example.org/flood-ontology#is_represented_by> .

<http://example.org/flood-ontology#is_served_by> rdfs:domain <http://example.org/flood-ontology#Entity>;
  rdfs:range <http://example.org/flood-ontology#Infrastructure>;
  owl:inverseOf <http://example.org/flood-ontology#serves> .

<http://example.org/flood-ontology#serves> rdfs:domain <http://example.org/flood-ontology#Infrastructure>;
  rdfs:range <http://example.org/flood-ontology#Entity>;
  owl:inverseOf <http://example.org/flood-ontology#is_served_by> .

<http://example.org/flood-ontology#is_shaped_by> rdfs:domain <http://example.org/flood-ontology#owl_Thing>;
  rdfs:range <http://example.org/flood-ontology#owl_Thing>;
  owl:inverseOf <http://example.org/flood-ontology#shapes> .

<http://example.org/flood-ontology#shapes> rdfs:domain <http://example.org/flood-ontology#owl_Thing>;
  rdfs:range <http://example.org/flood-ontology#owl_Thing>;
  owl:inverseOf <http://example.org/flood-ontology#is_shaped_by> .

<http://example.org/flood-ontology#is_threatened_by> rdfs:domain <http://example.org/flood-ontology#Entity>;
  rdfs:range <http://example.org/flood-ontology#Hazard>;
  owl:inverseOf <http://example.org/flood-ontology#threatens> .

<http://example.org/flood-ontology#is_used_by> rdfs:domain <http://example.org/flood-ontology#owl_Thing>;
  rdfs:range <http://example.org/flood-ontology#owl_Thing>;
  owl:inverseOf <http://example.org/flood-ontology#uses> .

<http://example.org/flood-ontology#uses> rdfs:domain <http://example.org/flood-ontology#owl_Thing>;
  rdfs:range <http://example.org/flood-ontology#owl_Thing>;
  owl:inverseOf <http://example.org/flood-ontology#is_used_by> .

<http://example.org/flood-ontology#may_be_caused_by> rdfs:domain <http://example.org/flood-ontology#Process>;
  rdfs:range <http://example.org/flood-ontology#Infrastructure>;
  owl:inverseOf <http://example.org/flood-ontology#may_cause> .

<http://example.org/flood-ontology#may_cause> rdfs:domain <http://example.org/flood-ontology#Infrastructure>;
  rdfs:range <http://example.org/flood-ontology#Process>;
  owl:inverseOf <http://example.org/flood-ontology#may_be_caused_by> .

<http://example.org/flood-ontology#measured_by> rdfs:domain <http://example.org/flood-ontology#owl_Thing>;
  rdfs:range <http://example.org/flood-ontology#Observation_Measurement>;
  owl:inverseOf <http://example.org/flood-ontology#measures> .

<http://example.org/flood-ontology#validated_by> rdfs:domain <http://example.org/flood-ontology#Observation_Measurement>;
  rdfs:range <http://example.org/flood-ontology#Process>;
  owl:inverseOf <http://example.org/flood-ontology#validates> .

<http://example.org/flood-ontology#validates> rdfs:domain <http://example.org/flood-ontology#Process>;
  rdfs:range <http://example.org/flood-ontology#Observation_Measurement>;
  owl:inverseOf <http://example.org/flood-ontology#validated_by> .

