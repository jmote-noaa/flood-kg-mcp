rdf:first rdfs:domain rdf:List .

rdf:rest rdfs:domain rdf:List;
  rdfs:range rdf:List .

<http://example.org/flood-ontology#determined_by> rdfs:domain <http://example.org/flood-ontology#owl_Thing>;
